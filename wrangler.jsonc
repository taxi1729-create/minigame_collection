{
  // あそびばこ — Cloudflare Workers（静的ファイル＋AI中継）
  // Cloudflare の Worker 名はこの name と同じにすること
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "asobibiako",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // /api/ だけ Worker が処理し、それ以外は public/ のファイルをそのまま返す
    "run_worker_first": ["/api/*"]
  },
  // Cloudflare の画面で設定した変数（AI_PROVIDER / CLAUDE_MODEL / GEMINI_MODEL など）を
  // デプロイのたびに消したり上書きしたりしない
  "keep_vars": true,
  // 秘密の値（GAME_PASSCODE / CLAUDE_API_KEY / GEMINI_API_KEY）は
  // Cloudflare の画面（Secret）か `npx wrangler secret put 名前` で登録する。ここには書かない。
  // ゲストのAI利用回数（サイト全体で1日◯回）を数える Durable Object
  "durable_objects": {
    "bindings": [{ "name": "USAGE", "class_name": "UsageCounter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UsageCounter"] }],
  "observability": { "enabled": true }
}
